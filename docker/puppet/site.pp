# ==============================================================================
# Puppet Manifest — site.pp
# Methodology: Tool 1. Puppet — Configuration Management
# Author: MD AZHAR
# Description: Automates server configuration, software packages, and ensures
#              the AI Business Recommendation application remains in desired state.
# ==============================================================================

node default {
  # 1. Ensure required runtime directory structure exists
  file { ['/app/logs', '/app/database', '/var/log/ai-business', '/etc/devops']:
    ensure => directory,
    mode   => '0755',
  }

  # 2. Maintain environment configuration consistency
  file { '/app/.env.production':
    ensure  => present,
    content => "# Generated by Puppet Configuration Management\nENVIRONMENT=production\nAPP_NAME=AIBusinessGuider\nLOG_LEVEL=INFO\n",
    mode    => '0644',
  }

  # 3. Ensure Nagios monitoring plugins directory permissions
  file { '/usr/lib/nagios/plugins':
    ensure => directory,
    mode   => '0755',
  }

  # 4. Notify about desired state convergence
  notify { 'puppet_state_enforced':
    message => 'Puppet has enforced desired state for AI Business Recommendation platform.',
  }
}

